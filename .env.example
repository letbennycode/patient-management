# Postgres (used by the db service). Local development credentials only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patients

# Backend (inside compose the host is the service name `db`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/patients
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/patients_test
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173
# Optional LLM summary. Sends REDACTED clinical text to Anthropic; needs BOTH the flag and a key.
# Use only with fake data or under a BAA. Leave off to use the built-in template summary.
LLM_SUMMARY_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Frontend
VITE_API_URL=http://localhost:8000
